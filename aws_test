// ================= SETUP =================
void setup() {
  pinMode(modem_rst, OUTPUT);
  pinMode(post_led, OUTPUT);
  digitalWrite(modem_rst, HIGH);
  delay(2000);
  digitalWrite(modem_rst, LOW);
  Serial.begin(9600);
  delay(2000);

  loadCredentials();

  Serial2.begin(9600, SERIAL_8N1, 16, 17);
  uart_set_loop_back(UART_NUM_2, false);

  simSerial.setRxBufferSize(2048);
  simSerial.begin(9600, SERIAL_8N1, 32, 33);
  simMutex = xSemaphoreCreateMutex();

  simInit();

  WiFi.mode(WIFI_STA);
  WiFi.onEvent([](WiFiEvent_t event, WiFiEventInfo_t info) {
    if (event == ARDUINO_EVENT_WIFI_STA_GOT_IP) {
      Serial.println("✅ WiFi Connected - Got IP");
      updateWiFiIP();
    }
    if (event == ARDUINO_EVENT_WIFI_STA_DISCONNECTED) {
      Serial.println("❌ WiFi Disconnected");
    }
  });

  if (connectWiFi()) {
    Serial.println("🌐 WiFi Available at boot");
  } else {
    Serial.println("📶 Will use SIM");
  }

  configTime(19800, 0, "pool.ntp.org");

  dht.begin();
  Wire.begin(21, 22);
  ina219.begin();
  ina219.setCalibration_32V_1A();

  xTaskCreatePinnedToCore(TaskSensors, "SENS", 5120, NULL, 1, NULL, 1);
  xTaskCreatePinnedToCore(TaskGPS, "GPS", 6144, NULL, 1, &gpsTaskHandle, 0);  //modem_redy = 1;
  xTaskCreatePinnedToCore(TaskPrint, "PRINT", 4096, NULL, 1, NULL, 1);
  xTaskCreatePinnedToCore(taskHMI, "taskHMI", 8192, NULL, 1, NULL, 1);
  xTaskCreatePinnedToCore(TaskHMIcommand, "HMIcmd", 8192, NULL, 1, NULL, 1);

  // ================= WEB SERVER ROUTES =================
  server.on("/", handleRoot);  // ← THIS WAS MISSING!

  server.on("/data", HTTP_GET, []() {  // Bonus: JSON API
    StaticJsonDocument<512> doc;
    doc["temperature"] = t;
    doc["humidity"] = h;
    doc["voltage"] = busVoltage;
    doc["current"] = current_mA;
    doc["power"] = power_mW;
    doc["ckwh"] = ckwh;
    doc["lat"] = latitude;
    doc["lon"] = longitude;
    doc["time"] = getTimeStamp();
    doc["gnss"] = gnss;
    doc["network"] = (network == 1) ? "WiFi" : (network == 2 ? "SIM" : "Offline");

    String json;
    serializeJson(doc, json);
    server.send(200, "application/json", json);
  });

  server.on("/download", HTTP_GET, []() {
    if (SPIFFS.exists("/log.csv")) {
      File file = SPIFFS.open("/log.csv", "r");
      server.streamFile(file, "text/csv");
      file.close();
    } else {
      server.send(404, "text/plain", "No log file found yet.");
    }
  });

  server.onNotFound([]() {
    server.send(404, "text/html", "<h1>404 - Not Found</h1><p><a href='/'>← Back to Dashboard</a></p>");
  });

  Serial.println("🌐 Web routes registered");

  // === Start Tasks ===
  xTaskCreatePinnedToCore(TaskWebServer, "WebSrv", 8192, NULL, 1, &webTaskHandle, 0);
  xTaskCreatePinnedToCore(TaskAWS, "AWS", 8192, NULL, 2, &awsTaskHandle, 1);

  Serial.println("🚀 System Ready");
}

// ================= LOOP =================
void loop() {
  static unsigned long lastWiFiRetry = 0;

  if (millis() - lastWiFiRetry > 10000) {
    lastWiFiRetry = millis();
    if (WiFi.status() != WL_CONNECTED && wifi_ssid.length() > 0) {
      WiFi.reconnect();
    }
  }

  if (millis() - lastPub > post_interval) {
    publishMessage();
    digitalWrite(post_led, HIGH);
    delay(100);
    digitalWrite(post_led, LOW);
    lastPub = millis();
  }

  if (millis() - lastHMIrecord > post_interval) {
    addDataRecord();
    lastHMIrecord = millis();
  }

  vTaskDelay(100 / portTICK_PERIOD_MS);
}
