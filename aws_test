  sendAT("AT+HTTPPARA=\"CONTENT\",\"application/json\"", 1000);

  String cmd = "AT+HTTPDATA=" + String(json.length()) + ",10000";
  if (sendAT(cmd, 3000).indexOf("DOWNLOAD") == -1) return;

  simSerial.print(json);
  vTaskDelay(1000 / portTICK_PERIOD_MS);
  sendAT("AT+HTTPACTION=1", 12000);
  sendAT("AT+HTTPREAD", 3000);
  sendAT("AT+HTTPTERM", 1000);
}

void publishMessage() {
  StaticJsonDocument<256> doc;
  doc["temperature"] = t;
  doc["humidity"] = h;
  doc["voltage"] = busVoltage;
  doc["current"] = current_mA;
  doc["power"] = power_mW;
  //doc["ckwh"] = ckwh;           // ← I recommend enabling this
  doc["lat"] = latitude;
  doc["lon"] = longitude;
  doc["time"] = getTimeStamp();
  doc["gnss"] = gnss;

  char buf[512];
  serializeJson(doc, buf);

  if (WiFi.status() == WL_CONNECTED && client.connected()) {
    client.publish(AWS_IOT_PUBLISH_TOPIC, buf);
    iv_done = 1;
    Serial.println("📤 Published to AWS");
  } else if (isSIMConnected()) {
    while (gnss_done == 0) {
      vTaskDelay(500 / portTICK_PERIOD_MS);
    }
    iv_done = 0;
    //vTaskSuspend(gpsTaskHandle);
    sendDataSIM(String(buf));
    //vTaskResume(gpsTaskHandle);
    iv_done = 1;
  }
  //modem_redy = 1;
}


// ================= TASKS =================
void TaskSensors(void *pv) {
  while (1) {
    float h_new = dht.readHumidity();
    float t_new = dht.readTemperature();
    if (!isnan(h_new) && !isnan(t_new)) {
      h = h_new;
      t = t_new;
    }

    busVoltage = (ina219.getBusVoltage_V() + 0.7);
    current_mA = ina219.getCurrent_mA();
    if (current_mA < 0) current_mA = 0;
    power_mW = ina219.getPower_mW();

    calculateEnergy();
    saveCKWh();
    vTaskDelay(3000 / portTICK_PERIOD_MS);
  }
}

void TaskGPS(void *pv) {
  while (1) {
    while (iv_done == 0) {
      vTaskDelay(500 / portTICK_PERIOD_MS);
    }
    gnss_done = 0;
    readSIMGPS();
    gnss_done = 1;
    led_marker();
    vTaskDelay(5000 / portTICK_PERIOD_MS);
    //modem_redy=0;
  }
}

