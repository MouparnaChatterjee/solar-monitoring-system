// ================= HMI =================
void processHMICommand() {
  while (Serial2.available()) {
    char c = Serial2.read();
    hmiBuffer += c;
    if (hmiBuffer.length() > 128) hmiBuffer = "";
  }

  if (hmiBuffer.length() > 0) {
    Serial.print("📥 HMI Command Received: ");
    Serial.println(hmiBuffer);

    if (hmiBuffer.indexOf("esp_reset") != -1) {
      digitalWrite(modem_rst, HIGH);
      delay(2000);
      digitalWrite(modem_rst, LOW);
      ESP.restart();
    }

    else if (hmiBuffer.indexOf("cleare_ckwh") != -1) {
      ckwh = 0.0;
      lastEnergyCalc = millis();
      saveCKWh();
      Serial.println("🗑️ CKWh Reset to 0 and saved");
    } else if (hmiBuffer.indexOf("ssid_") != -1) {
      wifi_ssid = hmiBuffer.substring(5);
      wifi_ssid.trim();
      prefs.begin("credentials", false);
      prefs.putString("ssid", wifi_ssid);
      prefs.end();
    } else if (hmiBuffer.indexOf("password_") != -1) {
      wifi_pass = hmiBuffer.substring(9);
      wifi_pass.trim();
      prefs.begin("credentials", false);
      prefs.putString("pass", wifi_pass);
      prefs.end();
    } else if (hmiBuffer.indexOf("apn_") != -1) {
      sim_apn = hmiBuffer.substring(4);
      sim_apn.trim();
      prefs.begin("credentials", false);
      prefs.putString("apn", sim_apn);
      prefs.end();
    } else if (hmiBuffer.indexOf("post_interval_") != -1) {
      post_int = hmiBuffer.substring(14);
      sim_apn.trim();
      prefs.begin("credentials", false);
      prefs.putString("post_int", post_int);
      prefs.end();
      post_interval = (post_int.toInt() * 1000);
    }  //int post_interval = 20000;
    //>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>..
    // ====================== SYNC COMMAND ======================
    else if (hmiBuffer.indexOf("sync_started") != -1) {
      Serial.println("🔄 [SYNC] Large Logging Started from HMI - Clearing old data...");

      // === DELETE OLD FILE ===
      if (SPIFFS.exists("/log.csv")) {
        if (SPIFFS.remove("/log.csv")) {
          Serial.println("🗑️ Old log.csv deleted successfully");
        } else {
          Serial.println("⚠️ Failed to delete old log.csv");
        }
      }

      // === START NEW FILE ===
      if (!SPIFFS.begin(true)) {
        Serial.println("❌ SPIFFS Mount Failed during sync");
        hmiBuffer = "";
        return;
      }

      File file = SPIFFS.open("/log.csv", FILE_WRITE);  // FILE_WRITE creates new file
      if (!file) {
        Serial.println("❌ Failed to create new log.csv");
        hmiBuffer = "";
        return;
      }

      // Write header
      file.println("Date,Time,Temperature,Humidity,Voltage,Current,Power,CKWh,Latitude,Longitude");
      file.close();

      Serial.println("✅ New log.csv created. Receiving data...");

      // === RECEIVE DATA FROM HMI ===
      String log_data;
      unsigned long syncTimeout = millis();

      while (true) {
        if (millis() - syncTimeout > 60000) {  // 60 second safety timeout
          Serial.println("⏰ Sync timeout!");
          break;
        }

        if (Serial2.available()) {
          log_data = Serial2.readStringUntil('$');
          log_data.trim();

          if (log_data.indexOf("end_log") != -1) {
            Serial.println("✅ Received end_log signal - Sync Finished");
            break;
          }

          if (log_data.length() > 10) {  // Avoid empty/invalid lines
            appendToCSVFromHMI(log_data);
            Serial.println("✓ Appended: " + log_data.substring(0, 60) + "...");
          }
        }
        vTaskDelay(10 / portTICK_PERIOD_MS);
      }

      Serial.println("🎉 SYNC Completed Successfully");
    }

    //>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>

    hmiBuffer = "";
  }
}

// ================= TIME =================
String getTimeStamp() {
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) return "0";
  char buf[30];
  strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &timeinfo);
  return String(buf);
}

String sendAT(String command, uint32_t timeout = 2500) {
  String temp = "";
  if (xSemaphoreTake(simMutex, pdMS_TO_TICKS(10000))) {
    while (simSerial.available()) simSerial.read();
    simSerial.println(command);
    Serial.print(">> ");
    Serial.println(command);

    uint32_t start = millis();
    while (millis() - start < timeout) {
      while (simSerial.available()) {
        char c = simSerial.read();
        if (c == '\r' || c == '\n' || (c >= 32 && c <= 126)) temp += c;
      }
      vTaskDelay(10);
    }
    xSemaphoreGive(simMutex);
  }
  return temp;
}

