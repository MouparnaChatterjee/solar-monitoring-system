void appendToCSVFromHMI(String rawLine) {
  if (!SPIFFS.begin(true)) return;

  File file = SPIFFS.open("/log.csv", FILE_APPEND);
  if (!file) return;

  if (file.size() == 0) {
    file.println("Date,Time,Temperature,Humidity,Voltage,Current,Power,CKWh,Latitude,Longitude");
  }

  // Replace ^ with , to convert to proper CSV
  rawLine.replace("^", ",");
  file.println(rawLine);
  file.close();
}


//==========================================================================
void TaskAWS(void *pvParameters) {
  Serial.println("☁️ AWS Task Started on Core " + String(xPortGetCoreID()));

  while (true) {
    if (WiFi.status() == WL_CONNECTED) {
      if (!client.connected()) {
        if (millis() - lastAWSAttempt > 8000) {
          lastAWSAttempt = millis();
          connectAWS();  // Safe here
        }
      } else {
        client.loop();  // Keep connection alive
      }
    }
    vTaskDelay(100 / portTICK_PERIOD_MS);
  }
}

//==========================================================================
void TaskWebServer(void *pvParameters) {
  Serial.println("🌐 WebServer Task Started on Core " + String(xPortGetCoreID()));

  while (true) {
    if (WiFi.status() == WL_CONNECTED) {
      if (!webServerRunning) {
        server.begin();
        webServerRunning = true;
        Serial.println("✅ Web Server Started → http://" + WiFi.localIP().toString());
      }
      server.handleClient();  // Must be called as fast as possible
    } else {
      if (webServerRunning) {
        server.stop();
        webServerRunning = false;
        Serial.println("⛔ Web Server Stopped (No WiFi)");
      }
    }

    vTaskDelay(5 / portTICK_PERIOD_MS);  // Very small delay = responsive
  }
}


