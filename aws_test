bool waitForNextion(String expected, unsigned long timeout = 8000) {
  unsigned long startTime = millis();
  nextionData = "";
  Serial.println("Waiting for: " + expected);
  while (millis() - startTime < timeout) {
    while (Serial2.available()) {
      char c = Serial2.read();
      nextionData += c;
      if (nextionData.indexOf(expected) != -1) {
        Serial.println("✓ Received: " + expected);
        return true;
      }
      if (nextionData.length() > 100) nextionData = "";
    }
    delay(10);
  }
  Serial.println("✗ Timeout");
  return false;
}

bool connectWiFi(unsigned long timeoutMs = 15000) {
  if (wifi_ssid.length() == 0) return false;
  WiFi.mode(WIFI_STA);
  WiFi.begin(wifi_ssid.c_str(), wifi_pass.c_str());
  Serial.printf("🔗 Connecting to WiFi: %s\n", wifi_ssid.c_str());

  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < timeoutMs) {
    delay(500);
    Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("\n✅ WiFi Connected");
    updateWiFiIP();
    return true;
  }
  Serial.println("\n❌ WiFi Failed");
  return false;
}

