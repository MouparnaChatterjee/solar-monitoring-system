void simInit() {
  Serial.println("🔄 Starting SIM7672 Initialization...");

  // Basic modem setup
  simSerial.println("AT");
  delay(1000);
  simSerial.println("ATE0");
  delay(500);
  simSerial.println("AT+CMEE=2");
  delay(500);
  simSerial.println("AT+CREG=1");
  delay(1000);
  simSerial.println("AT+CGREG=1");
  delay(1000);
  simSerial.println("AT+CEREG=1");
  delay(1000);
  simSerial.println("AT+CGATT=1");
  delay(2000);

  // APN
  simSerial.print("AT+CGDCONT=1,\"IP\",\"");
  simSerial.print(sim_apn);
  simSerial.println("\"");
  delay(1500);
  simSerial.println("AT+CGACT=1,1");
  delay(3000);

  // ================= GNSS INITIALIZATION =================
  Serial.println("🔄 Initializing GNSS...");

  sendAT("AT+CGNSSPWR=0", 3000);  // Turn OFF first
  delay(2000);

  Serial.println("🔌 Turning GNSS ON...");
  sendAT("AT+CGNSSPWR=1", 20000);  // Long timeout

  // Check status multiple times
  bool gnssReady = false;
  for (int i = 0; i < 15; i++) {
    String status = sendAT("AT+CGNSSPWR?", 2000);
    Serial.println("GNSS Status: [" + status + "]");

    if (status.indexOf("1") != -1 || status.indexOf("READY") != -1) {  // Accept 0,0,1 or READY
      gnssReady = true;
      Serial.println("✅ GNSS Powered ON");
      break;
    }
    delay(1500);
  }

  if (!gnssReady) {
    Serial.println("⚠️ GNSS Power ON may have failed");
  }

  sendAT("AT+CGNSSMODE=1", 1500);  // GPS + GLONASS + BeiDou
  sendAT("AT+CGNSSPORTSWITCH=1,1", 1500);
  sendAT("AT+CGNSSNMEARATE=1", 1500);

  // Optional: Cold start on first boot
  // sendAT("AT+CGPSCOLD", 5000);

  Serial.println("✅ SIM & GNSS Init Completed");
}


bool isSIMConnected() {
  static unsigned long lastSimCheck = 0;
  static bool lastState = false;
  static uint8_t failCount = 0;

  if (millis() - lastSimCheck < 15000) return lastState;  // <--- Increase to 15s
  lastSimCheck = millis();

  String resp1 = sendAT("AT+CREG?", 1500);
  String resp2 = sendAT("AT+CGACT?", 1500);

  bool registered = (resp1.indexOf(",1") != -1 || resp1.indexOf(",5") != -1);
  bool attached = (resp2.indexOf("+CGACT: 1,1") != -1);

  bool currentState = registered && attached;
  if (currentState) {
    failCount = 0;
    lastState = true;
  } else {
    failCount++;
    if (failCount >= 5) lastState = false;  // More tolerance
  }
  return lastState;
}
void readSIMGPS() {
  static unsigned long lastGNSSAttempt = 0;
  static int errorCount = 0;

  if (millis() - lastGNSSAttempt < 6000) return;
  lastGNSSAttempt = millis();

  Serial.println("\n📡 ============== GNSS QUERY ==============");

  while (simSerial.available()) simSerial.read();  // Flush buffer

  String resp = sendAT("AT+CGNSSINFO", 10000);  // Long timeout

  Serial.println("📥 RAW: [" + resp + "]");

  resp.replace("\r", "");
  resp.replace("\n", "");
  resp.trim();

  if (resp.indexOf("ERROR") != -1) {
    Serial.println("❌ GNSS Command ERROR");
    gnss = "ERROR";
    errorCount++;

    if (errorCount >= 5) {
      Serial.println("🔄 Restarting GNSS engine...");
      sendAT("AT+CGNSSPWR=0", 3000);
      delay(2000);
      sendAT("AT+CGNSSPWR=1", 15000);
      errorCount = 0;
    }
    return;
  }

  errorCount = 0;

  // No fix yet
  if (resp.indexOf("+CGNSSINFO: 0") != -1 || resp.indexOf(",,,,,") != -1 || resp.length() < 40) {

    gnss = "SEARCH";
    Serial.println("🌍 GNSS Searching... (No satellite fix yet)");
    return;
  }

  // Parse data
  int idx = resp.indexOf("+CGNSSINFO:");
  if (idx == -1) {
    gnss = "FORMAT_ERROR";
    Serial.println("⚠️ Format error");
    return;
  }

  String data = resp.substring(idx + 12);
  data.trim();

  String fields[15];
  int count = 0, startPos = 0;
  for (int i = 0; i < data.length() && count < 15; i++) {
    if (data[i] == ',') {
      fields[count++] = data.substring(startPos, i);
      startPos = i + 1;
    }
  }
  if (startPos < data.length()) fields[count++] = data.substring(startPos);

  if (count < 8) {
    gnss = "INCOMPLETE";
    return;
  }

  String latStr = fields[5];
  String latDir = fields[6];
  String lonStr = fields[7];
  String lonDir = fields[8];

  latitude = latStr.toDouble();
  longitude = lonStr.toDouble();

  if (latDir == "S" || latDir == "s") latitude = -latitude;
  if (lonDir == "W" || lonDir == "w") longitude = -longitude;

  gnss = "LOCKED";
  Serial.printf("✅ GNSS LOCKED → Lat: %.7f  Lon: %.7f\n", latitude, longitude);
}


