// ================= FIXED taskHMI =================
void taskHMI(void *pvParameters) {
  Serial.println("Task HMI started");

  bool ready = waitForNextion("system_ready", 10000);
  if (ready) {
    Serial.println("Nextion is READY!");
    sendCommand("t0.txt=\"System Ready\"");
  }

  vTaskDelay(1000 / portTICK_PERIOD_MS);
  sendCommand("page page1");
  vTaskDelay(1000 / portTICK_PERIOD_MS);
  sendCommand("page page1");
  vTaskDelay(1000 / portTICK_PERIOD_MS);
  sendCommand("page page1");

  while (true) {                                                   // Must never exit
    if (millis() - update_loop >= (network == 3 ? 8000 : 2000)) {  // slower when offline
      updateWiFiIP();
      updateNetworkStatus();

      sendCommand("page1.t7.txt=\"" + String(ckwh, 6) + "\"");
      sendCommand("page1.t4.txt=\"" + String(busVoltage, 2) + "\"");
      sendCommand("page1.t5.txt=\"" + String(current_mA, 2) + "\"");
      sendCommand("page1.t6.txt=\"" + String(power_mW, 0) + "\"");
      sendCommand("page1.t9.txt=\"" + String(t, 1) + "\"");
      sendCommand("page1.t8.txt=\"" + String(h, 0) + "\"");
      sendCommand("page1.t2.txt=\"" + String(longitude, 6) + "\"");
      sendCommand("page1.t3.txt=\"" + String(latitude, 6) + "\"");
      sendCommand("page1.t1.txt=\"" + ip + "\"");
      sendCommand("page1.va7.val=" + String(network));
      sendCommand("page1.t10.txt=\"" + gnss + "\"");


      update_loop = millis();
    }
    vTaskDelay(500 / portTICK_PERIOD_MS);
  }
}

void addDataRecord() {
  String cmd = String(t, 2) + "^" + String(h, 2) + "^" + String(busVoltage, 2) + "^" + String(current_mA, 3) + "^" + String(power_mW, 1) + "^" + String(ckwh, 4) + "^" + String(latitude, 6) + "^" + String(longitude, 6);

  sendCommand("page9.tva0.txt=\"" + cmd + "\"");
  vTaskDelay(1000 / portTICK_PERIOD_MS);
  sendCommand("page9.va0.txt=\"update\"");
