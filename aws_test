//==========================================================================
void calculateEnergy() {
  unsigned long now = millis();
  if (lastEnergyCalc == 0) {
    lastEnergyCalc = now;
    return;
  }

  float deltaSeconds = (now - lastEnergyCalc) / 1000.0;
  float power_kW = power_mW / 1000000.0;
  ckwh += power_kW * (deltaSeconds / 3600.0);
  lastEnergyCalc = now;
}
